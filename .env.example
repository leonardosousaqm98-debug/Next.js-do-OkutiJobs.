# Public values: safe for browser bundles
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
NEXT_PUBLIC_APP_URL=https://app.okutijobs.com

# Server-only value: never prefix with NEXT_PUBLIC_ and never commit it
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Mister Okuti — configure pelo menos um fornecedor no ambiente server-side da Vercel.
# Nunca use NEXT_PUBLIC_ para chaves de IA.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Opcional: substitui o modelo predefinido para o fornecedor escolhido.
MISTER_OKUTI_MODEL=
# Opcional, apenas para endpoints compatíveis com OpenAI.
OPENAI_BASE_URL=
